# .env.example — szablon zmiennych środowiskowych TerraLens
# Skopiuj do .env i wypełnij. NIE commituj .env (jest w .gitignore).

# --- NASA Earthdata Login (wymagane dla SRTM DEM w T2.4) ---
# Rejestracja: https://urs.earthdata.nasa.gov/users/new
# Authorized Apps: LP DAAC Data Pool, LP DAAC Cumulus, ORNL DAAC Daymet
NASA_EARTHDATA_USER=
NASA_EARTHDATA_PASS=

# --- Hugging Face Datasets (wymagane dla T5.3 deploy) ---
# Token write: https://huggingface.co/settings/tokens → New token → Write
# Repo: uruchom scripts/setup_hf_repo.py po wpisaniu tokenu
HF_TOKEN=
HF_REPO_ID=Piotr1686/terralens-data
HF_PUBLIC_URL=https://huggingface.co/datasets/Piotr1686/terralens-data/resolve/main

# --- Cloudflare R2 (fallback — wymaga karty kredytowej) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=terralens-data
R2_PUBLIC_URL=

# --- api.nasa.gov — OPCJONALNE (tylko Faza 2, Earth Imagery API) ---
# GIBS (primary source) NIE używa tego klucza. Dla MVP niepotrzebny.
NASA_API_KEY=
